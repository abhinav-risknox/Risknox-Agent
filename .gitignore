# ==========================
# Third-party (vendored)
# ==========================
# Header-only libraries in thirdparty/ ARE tracked (nlohmann, spdlog, httplib, sqlite3).
# Only ignore build artifacts that may appear inside thirdparty/.
thirdparty/**/CMakeFiles/
thirdparty/**/build/
thirdparty/**/*.o
thirdparty/**/*.a

# ClamAV binaries & virus databases (~210 MB) - store in artifact storage, not Git
vendor/clamav/
!vendor/
!vendor/clamav/
vendor/clamav/*
!vendor/clamav/certs/
!vendor/clamav/certs/clamav.crt
!vendor/clamav/freshclam.conf
!vendor/clamav/manifest.json
!vendor/clamav/update_definitions.bat

