<Window x:Class="ThreatNotification.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Risknox Threat" Width="520" Height="120"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="BrushBg" Color="#1C1C1E"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#2E2E30"/>
        <SolidColorBrush x:Key="BrushTextDim" Color="#606066"/>
        <SolidColorBrush x:Key="BrushTextSec" Color="#A0A0A4"/>

        <!-- Close Button -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#606066"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quarantine Pill -->
        <Style x:Key="QuarantinePillStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10.7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBorder" CornerRadius="17">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FF5B00" Offset="0"/>
                                    <GradientStop Color="#FF3B00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PillBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Text Link -->
        <Style x:Key="TextLinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#606066"/>
            <Setter Property="FontSize" Value="9.3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- ══ Main Container ════════════════════════════════════════ -->
    <Border x:Name="MainBorder" CornerRadius="10" ClipToBounds="True"
            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
            Background="{StaticResource BrushBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3" Color="Black"/>
        </Border.Effect>

        <Canvas x:Name="MainCanvas">
            <!-- ── Background warm glow ──────────────────────── -->
            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="60" Height="200">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#201A18" Offset="0"/>
                        <GradientStop Color="#1C1C1E" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ── Left Accent Bar ───────────────────────────── -->
            <Rectangle x:Name="AccentBar" Canvas.Left="0" Canvas.Top="0"
                       Width="4" Height="200" Fill="#EF4444"/>

            <!-- ── Flame ─────────────────────────────────────── -->
            <Canvas Canvas.Left="18" Canvas.Top="10" Width="12" Height="14">
                <Polygon Points="0,4 4,1 4,13 0,10" Fill="#FF3B00"/>
                <Polygon Points="4,1 12,4 12,8 4,5" Fill="#FF6B00"/>
                <Polygon Points="4,7 12,10 12,14 4,11" Fill="#FF6B00"/>
            </Canvas>

            <!-- ── Brand ─────────────────────────────────────── -->
            <TextBlock Canvas.Left="32" Canvas.Top="8" Text="Risknox"
                       FontSize="10" FontWeight="Bold" Foreground="#606066"/>

            <!-- ── Close ─────────────────────────────────────── -->
            <Button x:Name="BtnClose" Content="✕" Canvas.Left="484" Canvas.Top="4"
                    Width="28" Height="24"
                    Style="{StaticResource CloseButtonStyle}" Click="BtnClose_Click"/>

            <!-- ── Icon Tile ─────────────────────────────────── -->
            <Border x:Name="IconTile" Canvas.Left="18" Canvas.Top="34"
                    Width="42" Height="42" CornerRadius="6"
                    Background="#2D1410" BorderBrush="#3D1A14" BorderThickness="1">
                <Grid>
                                    <!-- Shield icon (threat state) -->
                    <Canvas x:Name="ShieldGroup" Width="20" Height="24"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M10,1 L19,4 L19,12 C19,18 10,23 10,23 C10,23 1,18 1,12 L1,4 Z"
                              Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                        <Line X1="10" Y1="8" X2="10" Y2="15" Stroke="White" StrokeThickness="1.5"/>
                        <Ellipse Canvas.Left="8.5" Canvas.Top="17" Width="3" Height="3" Fill="White"/>
                    </Canvas>
                    <!-- Checkmark icon (confirmation state, hidden) -->
                    <Canvas x:Name="CheckGroup" Width="20" Height="20" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M3,10 L8,15 L17,4" Stroke="White" StrokeThickness="2.5"
                              Fill="Transparent" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                    <!-- USB icon (scanning state, hidden) -->
                    <Canvas x:Name="ScanGroup" Width="22" Height="22" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Rectangle Canvas.Left="7" Canvas.Top="0" Width="8" Height="11"
                                   Fill="Transparent" Stroke="White" StrokeThickness="1.5" RadiusX="1" RadiusY="1"/>
                        <Rectangle Canvas.Left="9" Canvas.Top="3" Width="2" Height="3" Fill="White"/>
                        <Rectangle Canvas.Left="11" Canvas.Top="3" Width="2" Height="3" Fill="White"/>
                        <Line X1="11" Y1="11" X2="11" Y2="18" Stroke="White" StrokeThickness="1.5"/>
                        <Rectangle Canvas.Left="5" Canvas.Top="18" Width="12" Height="4"
                                   Fill="Transparent" Stroke="White" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- ── File Type Badge (bottom-right of icon tile) ── -->
            <Border x:Name="FileTypeBadge" Canvas.Left="46" Canvas.Top="60"
                    Width="16" Height="16" CornerRadius="4"
                    Background="#1C1C1E" BorderBrush="#2E2E30" BorderThickness="1">
                <TextBlock x:Name="TxtFileType" Text="⚙" FontSize="9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="#A0A0A4"/>
            </Border>

            <!-- ── Main Text ─────────────────────────────────── -->
            <TextBlock x:Name="TxtMain" Canvas.Left="72" Canvas.Top="34"
                       Width="310" FontSize="12.7" FontWeight="Bold"
                       Foreground="White" TextTrimming="CharacterEllipsis">
                <Run x:Name="RunMainPrefix" Text="Threat Blocked &#x2014; "/><Run x:Name="RunFileName" Text="file.exe"/>
            </TextBlock>

            <!-- ── Threat + Severity Badge ────────────────────── -->
            <TextBlock x:Name="TxtThreat" Canvas.Left="72" Canvas.Top="54"
                       Width="310" FontSize="11" TextTrimming="CharacterEllipsis">
                <Run x:Name="RunThreatName" Text="Win.Test.MockThreat" Foreground="#A0A0A4"/>
                <Run Text="  "/>
                <InlineUIContainer>
                    <Border x:Name="SeverityBadge" Background="#EF4444" CornerRadius="3"
                            Padding="5,0,5,1" Margin="0,-2,0,0">
                        <TextBlock x:Name="TxtSeverity" Text="HIGH" FontSize="7.5"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                </InlineUIContainer>
            </TextBlock>

            <!-- ── File Path ─────────────────────────────────── -->
            <TextBlock x:Name="TxtPath" Canvas.Left="72" Canvas.Top="71"
                       Width="310" FontSize="10.5" Foreground="#606066"
                       TextTrimming="CharacterEllipsis"/>

            <!-- ── Quarantine Button ─────────────────────────── -->
            <Button x:Name="BtnQuarantine" Content="Quarantine"
                    Canvas.Left="394" Canvas.Top="32" Width="110" Height="34"
                    Style="{StaticResource QuarantinePillStyle}"
                    Click="BtnQuarantine_Click"/>

            <!-- ── Undo Link (confirmation state, hidden) ────── -->
            <TextBlock x:Name="LnkUndo" Text="Undo" Visibility="Collapsed"
                       Canvas.Left="432" Canvas.Top="42"
                       Style="{StaticResource TextLinkStyle}" FontSize="11"
                       MouseLeftButtonDown="LnkUndo_Click"/>

            <!-- ── Ignore · Details ──────────────────────────── -->
            <TextBlock x:Name="LnkIgnore" Text="Ignore" Canvas.Left="410" Canvas.Top="74"
                       Style="{StaticResource TextLinkStyle}" MouseLeftButtonDown="LnkIgnore_Click"/>
            <TextBlock x:Name="DotSep" Text="·" Canvas.Left="450" Canvas.Top="74"
                       Foreground="#606066" FontSize="9.3"/>
            <TextBlock x:Name="LnkDetails" Text="Details" Canvas.Left="458" Canvas.Top="74"
                       Style="{StaticResource TextLinkStyle}" MouseLeftButtonDown="LnkDetails_Click"/>

            <!-- ── Countdown Bar (2px thin at bottom) ────────── -->
            <Rectangle x:Name="CountdownBg" Canvas.Left="4" Canvas.Top="114"
                       Width="512" Height="2" Fill="#2A2A2C" RadiusX="1" RadiusY="1"/>
            <Rectangle x:Name="CountdownFill" Canvas.Left="4" Canvas.Top="114"
                       Width="512" Height="2" Fill="#404044" RadiusX="1" RadiusY="1"/>


        </Canvas>
    </Border>
</Window>
