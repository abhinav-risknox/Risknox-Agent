<Window x:Class="RisknoxMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Risknox Agent Monitor" Width="400" SizeToContent="Height" MinHeight="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI">
    
    <Window.Resources>
        <!-- Modern Full-Width Button Style -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.2"/>
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1F" CornerRadius="12" BorderBrush="#333334" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <!-- A tasteful dark drop shadow -->
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Direction="270" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Status Hero -->
                <RowDefinition Height="Auto"/> <!-- Details View -->
                <RowDefinition Height="Auto"/> <!-- Actions Area -->
                <RowDefinition Height="Auto"/> <!-- Log Viewer Area -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="#1A1A1B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Canvas Width="18" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                        <!-- Logo polished shapes -->
                        <Polygon Points="0,6 6,2 6,26 0,22" Fill="#FF3B00"/>
                        <Polygon Points="6,2 18,8 18,14 6,8" Fill="#FF6B00"/>
                        <Polygon Points="6,14 18,20 18,26 6,20" Fill="#FF6B00"/>
                    </Canvas>
                    <TextBlock Text="Risknox" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=".ai" Foreground="#A0A0A0" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnToggleLogs" Content="📑" Width="46" Height="36" Background="Transparent" Foreground="#A0A0A0" FontSize="15"
                            BorderThickness="0" Click="BtnOpenLogs_Click" Cursor="Hand" ToolTip="Toggle Live Logs">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="0,0,6,6" Background="{TemplateBinding Background}" Margin="0,0,4,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2B2B2C"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button x:Name="BtnClose" Content="✕" Width="46" Height="36" Background="Transparent" Foreground="#A0A0A0" FontSize="14"
                            BorderThickness="0" Click="BtnClose_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="0,0,0,6" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <!-- Bottom Divider -->
                <Border VerticalAlignment="Bottom" Height="1" Background="#2B2B2C" Grid.ColumnSpan="3"/>
            </Grid>

            <!-- Hero Status Area -->
            <StackPanel Grid.Row="1" Margin="20,15,20,10" HorizontalAlignment="Center">
                <Border Background="#2B2B2C" CornerRadius="20" Padding="16,10" BorderBrush="#333334" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Fill="#FFFD98" Width="12" Height="12" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFFD98" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="NOT INSTALLED" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Information Cards -->
            <ScrollViewer Grid.Row="2" Margin="20,0,20,5" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- System Info Card -->
                    <Border Background="#2B2B2C" CornerRadius="8" Padding="18" Margin="0,0,0,15" BorderBrush="#333334" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="SYSTEM INFORMATION" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,14" />
                            
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Service" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="ResolutePulse" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            
                            <Rectangle Height="1" Fill="#333334" Margin="0,0,0,12"/>
                            
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Network" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock Text="TCP / mTLS" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <Rectangle Height="1" Fill="#333334" Margin="0,0,0,12"/>

                            <Grid>
                                <TextBlock Text="Configuration" Foreground="#A0A0A0" FontSize="13" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="config.json" Foreground="#FFFFFF" FontSize="13" FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="BtnOpenConfig" Content="↗" Width="26" Height="26" Padding="0"
                                            Background="#333334" Foreground="#FF5B00" BorderThickness="0" FontSize="13" FontWeight="Bold"
                                            Cursor="Hand" Click="BtnOpenConfig_Click" ToolTip="Open Config Directory">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- License Card -->
                    <Border Background="#2B2B2C" CornerRadius="8" Padding="18" BorderBrush="#333334" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="LICENSE STATUS" FontSize="10" FontWeight="Bold" Foreground="#888888" Margin="0,0,0,4" />
                                <TextBlock x:Name="TxtLicenseType" Text="Checking..." Foreground="#FFFFFF" FontWeight="Medium" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtExpiry" Text="..." FontSize="14" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock x:Name="TxtLicenseDetail" Text="" FontSize="10" Foreground="#888888" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Error Banner (hidden by default) -->
                    <Border x:Name="ErrorBanner" Background="#3D1A00" CornerRadius="8" Padding="14" Margin="0,10,0,0" 
                            BorderBrush="#FF5B00" BorderThickness="1" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="⚠  ISSUE DETECTED" FontSize="10" FontWeight="Bold" Foreground="#FF8C42" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtError" Text="" Foreground="#FFAA66" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <Grid Grid.Row="3" Margin="20,20,20,20" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnStart" Grid.Column="0" Content="Start Agent" Height="44"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#FF5B00" Foreground="#FFFFFF"
                        Click="BtnStart_Click"/>

                <Button x:Name="BtnStop" Grid.Column="2" Content="Stop Agent" Height="44"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#333334" Foreground="#FFFFFF"
                        Click="BtnStop_Click"/>
            </Grid>

            <!-- Log Viewer Area -->
            <Grid x:Name="LogViewerGrid" Grid.Row="4" Visibility="Collapsed" Margin="20,0,20,20" Height="160">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="LIVE LOGS" FontSize="10" FontWeight="Bold" Foreground="#888888" VerticalAlignment="Center" />
                    <Button Content="✕" HorizontalAlignment="Right" Width="26" Height="26" Background="#333334" 
                            Foreground="#A0A0A0" BorderThickness="0" Click="BtnCloseLogs_Click" Cursor="Hand" ToolTip="Close Logs">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="#121212" CornerRadius="6" BorderBrush="#333334" BorderThickness="1">
                    <TextBox x:Name="TxtLogViewer" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0"
                             FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" Padding="12"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
