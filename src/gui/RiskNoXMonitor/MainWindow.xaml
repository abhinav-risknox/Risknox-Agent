<Window x:Class="RisknoxMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Risknox Agent Monitor" Height="450" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI">
    
    <Window.Resources>
    </Window.Resources>

    <Border Background="#1E1E1F" CornerRadius="15" BorderBrush="#333334" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Status Area -->
                <RowDefinition Height="*"/> <!-- Details View -->
                <RowDefinition Height="80"/> <!-- Actions Area -->
                <RowDefinition Height="Auto"/> <!-- Log Viewer Area -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                    <!-- Risknox Logo Vector -->
                    <Canvas Width="18" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                        <!-- Left Stem (Dark Orange) -->
                        <Polygon Points="0,4 6,0 6,24 0,20" Fill="#FF3B00"/>
                        <!-- Top Right Arm (Bright Orange) -->
                        <Polygon Points="6,0 18,6 18,12 6,6" Fill="#FF6B00"/>
                        <!-- Bottom Right Arm (Bright Orange) -->
                        <Polygon Points="6,12 18,18 18,24 6,18" Fill="#FF6B00"/>
                    </Canvas>
                    <TextBlock Text="Risknox.ai" Foreground="#FFFFFF" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="BtnClose" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="40" Height="30" Background="Transparent" Foreground="#EAEAEB"
                        BorderThickness="0" Click="BtnClose_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="0,15,0,0">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#C62828"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <!-- Status Visualizer -->
            <StackPanel Grid.Row="1" Margin="0,10,0,5" HorizontalAlignment="Center">
                <Grid Width="30" Height="15" Margin="0,0,0,5">
                    <Ellipse x:Name="StatusIndicator" Fill="#FFFD98" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Ellipse.Effect>
                            <BlurEffect Radius="3"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="StatusText" Text="RUNNING" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                <TextBlock Text="AGENT STATUS" FontSize="9" Foreground="#A0A0A0" FontWeight="Bold" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Information Cards -->
            <ScrollViewer Grid.Row="2" Margin="15,10,15,10" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <!-- Core Details Card -->
                    <Border Background="#2B2B2C" CornerRadius="10" Padding="15" Margin="0,0,0,15">
                        <StackPanel>
                            <TextBlock Text="DETAILS" FontSize="11" FontWeight="Bold" Foreground="#FF5B00" Margin="0,0,0,10"/>
                            <UniformGrid Columns="1">
                                <Grid Height="30">
                                    <TextBlock Text="Service" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBlock Text="ResolutePulse" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="Config" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="config.json" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button x:Name="BtnOpenConfig" Content="📁" Width="22" Height="22" Padding="0"
                                                Background="Transparent" Foreground="#FF5B00" BorderThickness="0"
                                                Cursor="Hand" Click="BtnOpenConfig_Click" ToolTip="Open Config Directory"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="Network" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <TextBlock Text="TCP / mTLS" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Height="30">
                                    <TextBlock Text="Logs" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="agent.log" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <Button x:Name="BtnOpenLogs" Content="📄" Width="22" Height="22" Padding="0"
                                                Background="Transparent" Foreground="#FF5B00" BorderThickness="0"
                                                Cursor="Hand" Click="BtnOpenLogs_Click" ToolTip="Open Agent Logs"/>
                                    </StackPanel>
                                </Grid>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- License Card -->
                    <Border Background="#2B2B2C" CornerRadius="10" Padding="15">
                        <StackPanel>
                            <TextBlock Text="LICENSE" FontSize="11" FontWeight="Bold" Foreground="#FF5B00" Margin="0,0,0,10"/>
                            <Grid Height="30">
                                <TextBlock Text="Expires In" Foreground="#A0A0A0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtExpiry" Text="Checking..." Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <Grid Grid.Row="3" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="BtnStart" Grid.Column="0" Content="START" Margin="0,0,10,20" Height="40"
                        Background="#FF5B00" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                        Click="BtnStart_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnStop" Grid.Column="1" Content="STOP" Margin="10,0,0,20" Height="40"
                        Background="#EAEAEB" Foreground="#1E1E1F" FontWeight="Bold" BorderThickness="0"
                        Click="BtnStop_Click" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Log Viewer Area -->
            <Grid x:Name="LogViewerGrid" Grid.Row="4" Visibility="Collapsed" Margin="15,0,15,15" Height="150">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="LIVE LOGS" FontSize="11" FontWeight="Bold" Foreground="#FF5B00" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="20" Height="20" Background="Transparent" 
                            Foreground="#EAEAEB" BorderThickness="0" Click="BtnCloseLogs_Click" Cursor="Hand" ToolTip="Close Logs"/>
                </Grid>
                <Border Grid.Row="1" Background="#121212" CornerRadius="8" BorderBrush="#333334" BorderThickness="1">
                    <TextBox x:Name="TxtLogViewer" Background="Transparent" Foreground="#A0A0A0" BorderThickness="0"
                             FontFamily="Consolas" FontSize="10" IsReadOnly="True" TextWrapping="Wrap" 
                             VerticalScrollBarVisibility="Auto" Padding="8"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
