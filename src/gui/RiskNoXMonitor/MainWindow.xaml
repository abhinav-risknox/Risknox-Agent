<Window x:Class="RisknoxMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Risknox Agent Monitor" Width="400" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.2"/>
                                <Setter Property="Foreground" Value="#66FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1F" CornerRadius="12" BorderBrush="#2A2A2C" BorderThickness="1" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Direction="270" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Hero Status -->
                <RowDefinition Height="38"/>   <!-- Tab Strip -->
                <RowDefinition Height="*"/>    <!-- Tab Content -->
                <RowDefinition Height="Auto"/> <!-- Actions -->
            </Grid.RowDefinitions>

            <!-- ══ Title Bar ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="#1A1A1B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Canvas Width="18" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Polygon Points="0,6 6,2 6,26 0,22" Fill="#FF3B00"/>
                        <Polygon Points="6,2 18,8 18,14 6,8" Fill="#FF6B00"/>
                        <Polygon Points="6,14 18,20 18,26 6,20" Fill="#FF6B00"/>
                    </Canvas>
                    <TextBlock Text="Risknox" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=".ai" Foreground="#606066" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnClose" Content="✕" Width="46" Height="36"
                            Background="Transparent" Foreground="#606066" FontSize="14"
                            BorderThickness="0" Click="BtnClose_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="0,0,0,6" Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#E81123"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border VerticalAlignment="Bottom" Height="1" Background="#252527" Grid.ColumnSpan="3"/>
            </Grid>

            <!-- ══ Hero Status ═════════════════════════════════════════════ -->
            <StackPanel Grid.Row="1" Margin="20,14,20,10" HorizontalAlignment="Center">
                <Border Background="#252527" CornerRadius="20" Padding="16,9" BorderBrush="#2E2E30" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusIndicator" Fill="#FFFD98" Width="11" Height="11" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#FFFD98" Opacity="0.5"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock x:Name="StatusText" Text="NOT INSTALLED" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPhase" Text="" FontSize="11" Foreground="#606066" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ══ Tab Strip ═══════════════════════════════════════════════ -->
            <Border Grid.Row="2" Background="#181819" BorderBrush="#252527" BorderThickness="0,1,0,1">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">

                    <!-- Overview Tab -->
                    <Grid x:Name="TabGrdOverview" Width="88" Height="38" Cursor="Hand"
                          MouseLeftButtonDown="TabOverview_Click">
                        <TextBlock x:Name="TabLblOverview" Text="Overview"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Medium" Foreground="#FFFFFF"/>
                        <Border x:Name="TabBarOverview" VerticalAlignment="Bottom" Height="2"
                                Background="#FF5B00" CornerRadius="1,1,0,0"/>
                    </Grid>

                    <!-- Components Tab -->
                    <Grid x:Name="TabGrdComponents" Width="102" Height="38" Cursor="Hand"
                          MouseLeftButtonDown="TabComponents_Click">
                        <TextBlock x:Name="TabLblComponents" Text="Components"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Medium" Foreground="#484850"/>
                        <Border x:Name="TabBarComponents" VerticalAlignment="Bottom" Height="2"
                                Background="#FF5B00" CornerRadius="1,1,0,0" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Logs Tab -->
                    <Grid x:Name="TabGrdLogs" Width="68" Height="38" Cursor="Hand"
                          MouseLeftButtonDown="TabLogs_Click">
                        <TextBlock x:Name="TabLblLogs" Text="Logs"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="12" FontWeight="Medium" Foreground="#484850"/>
                        <Border x:Name="TabBarLogs" VerticalAlignment="Bottom" Height="2"
                                Background="#FF5B00" CornerRadius="1,1,0,0" Visibility="Collapsed"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ Tab Content Area ════════════════════════════════════════ -->
            <Grid Grid.Row="3">

                <!-- ── Overview Tab ──────────────────────────────────────── -->
                <ScrollViewer x:Name="TabOverviewPanel" VerticalScrollBarVisibility="Hidden"
                              Margin="20,12,20,0">
                    <StackPanel>
                        <!-- System Info Card -->
                        <Border Background="#252527" CornerRadius="8" Padding="18" Margin="0,0,0,12"
                                BorderBrush="#2E2E30" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SYSTEM INFORMATION" FontSize="9" FontWeight="Bold"
                                           Foreground="#505056" Margin="0,0,0,14"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Service" Foreground="#909094" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="ResolutePulse" Foreground="#FFFFFF" FontSize="13"
                                               FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2E2E30" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Network" Foreground="#909094" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="TCP / mTLS" Foreground="#FFFFFF" FontSize="13"
                                               FontWeight="Medium" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2E2E30" Margin="0,0,0,12"/>
                                <Grid>
                                    <TextBlock Text="Configuration" Foreground="#909094" FontSize="13" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <TextBlock Text="config.json" Foreground="#FFFFFF" FontSize="13"
                                                   FontWeight="Medium" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button x:Name="BtnOpenConfig" Content="↗" Width="26" Height="26" Padding="0"
                                                Background="#2E2E30" Foreground="#FF5B00" BorderThickness="0"
                                                FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnOpenConfig_Click"
                                                ToolTip="Open Config Directory">
                                            <Button.Resources>
                                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- License Card -->
                        <Border Background="#252527" CornerRadius="8" Padding="18"
                                BorderBrush="#2E2E30" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="LICENSE STATUS" FontSize="9" FontWeight="Bold"
                                               Foreground="#505056" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtLicenseType" Text="Checking..."
                                               Foreground="#FFFFFF" FontWeight="Medium" FontSize="13"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtExpiry" Text="..." FontSize="14"
                                               Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TxtLicenseDetail" Text="" FontSize="10"
                                               Foreground="#606066" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Error Banner -->
                        <Border x:Name="ErrorBanner" Background="#3D1A00" CornerRadius="8" Padding="14"
                                Margin="0,10,0,0" BorderBrush="#FF5B00" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠  ISSUE DETECTED" FontSize="9" FontWeight="Bold"
                                           Foreground="#FF8C42" Margin="0,0,0,6"/>
                                <TextBlock x:Name="TxtError" Text="" Foreground="#FFAA66"
                                           FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- ── Components Tab ─────────────────────────────────────── -->
                <ScrollViewer x:Name="TabComponentsPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Hidden" Margin="20,8,20,0">
                    <Border x:Name="ComponentsCard" Background="#1A1A1B" CornerRadius="10"
                            Padding="14,4,14,4" BorderBrush="#2A2A2C" BorderThickness="1">
                        <StackPanel x:Name="ComponentsSections"/>
                    </Border>
                </ScrollViewer>

                <!-- ── Logs Tab ───────────────────────────────────────────── -->
                <Grid x:Name="TabLogsPanel" Visibility="Collapsed" Margin="20,12,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="LIVE LOGS" FontSize="9" FontWeight="Bold"
                               Foreground="#505056" Margin="0,0,0,8"/>
                    <Border Grid.Row="1" Background="#131315" CornerRadius="8"
                            BorderBrush="#2A2A2C" BorderThickness="1">
                        <TextBox x:Name="TxtLogViewer" Background="Transparent" Foreground="#808086"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="11"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" Padding="12"/>
                    </Border>
                </Grid>

            </Grid>

            <!-- ══ Actions ═════════════════════════════════════════════════ -->
            <Grid Grid.Row="4" Margin="20,14,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnStart" Grid.Column="0" Content="Start Agent" Height="42"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#FF5B00" Click="BtnStart_Click"/>
                <Button x:Name="BtnStop" Grid.Column="2" Content="Stop Agent" Height="42"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#2E2E30" Click="BtnStop_Click"/>
            </Grid>

        </Grid>
    </Border>
</Window>
