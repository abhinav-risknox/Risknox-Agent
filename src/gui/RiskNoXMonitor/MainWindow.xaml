<Window x:Class="RisknoxMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Risknox Agent Monitor" Width="400" Height="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.75"/>
                                <Setter TargetName="Border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Background" Value="#252527"/>
                                <Setter Property="Foreground" Value="#484850"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button Style -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
            <Setter Property="Background" Value="#252527"/>
            <Setter Property="Foreground" Value="#A0A0A4"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A2A2C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border x:Name="MainBorder" CornerRadius="12" BorderBrush="#2A2A2C" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <RadialGradientBrush Center="0.5,0.2" GradientOrigin="0.5,0.2" RadiusX="1" RadiusY="1">
                <GradientStop Color="#252527" Offset="0"/>
                <GradientStop Color="#1E1E1F" Offset="1"/>
            </RadialGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>   <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Hero Status -->
                <RowDefinition Height="*"/>    <!-- Main Dashboard -->
                <RowDefinition Height="Auto"/> <!-- Main Actions -->
            </Grid.RowDefinitions>

            <!-- ══ Title Bar ══════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Background="#1A1A1B" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Canvas Width="18" Height="24" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Polygon Points="0,6 6,2 6,26 0,22" Fill="#FF3B00"/>
                        <Polygon Points="6,2 18,8 18,14 6,8" Fill="#FF6B00"/>
                        <Polygon Points="6,14 18,20 18,26 6,20" Fill="#FF6B00"/>
                    </Canvas>
                    <TextBlock Text="Risknox" Foreground="#FFFFFF" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text=".ai" Foreground="#606066" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="BtnClose" Content="✕" Width="46" Height="36"
                            Background="Transparent" Foreground="#606066" FontSize="14"
                            BorderThickness="0" Click="BtnClose_Click" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Border VerticalAlignment="Bottom" Height="1" Background="#252527" Grid.ColumnSpan="3"/>
            </Grid>

            <!-- ══ Shield Strength Dashboard (Hero Area) ═══════════════════ -->
            <StackPanel Grid.Row="1" Margin="20,10,20,10" HorizontalAlignment="Center">
                <Grid Width="100" Height="100">
                    <!-- Outer Glow Ring -->
                    <Ellipse x:Name="ShieldOuterGlow" Margin="-5" Opacity="0.15">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop x:Name="GlowColorStop" Color="#22C55E" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- The Shield Icon -->
                    <Path x:Name="ShieldIcon" Data="M20,10 L80,10 L80,50 C80,80 50,100 50,100 C50,100 20,80 20,50 Z" 
                          Stretch="Uniform" Fill="#252527" Stroke="#2E2E30" StrokeThickness="2" Width="45" Height="45"
                          Cursor="Hand" MouseLeftButtonDown="ShieldIcon_MouseLeftButtonDown">
                        <Path.Effect>
                            <DropShadowEffect x:Name="ShieldGlow" BlurRadius="15" ShadowDepth="0" Color="#22C55E" Opacity="0.4"/>
                        </Path.Effect>
                    </Path>

                    <!-- Center Status Label -->
                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-15">
                        <TextBlock x:Name="StatusText" Text="PROTECTED" FontSize="14" FontWeight="Black" 
                                   Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="TxtShieldDetail" Text="All systems operational" FontSize="9" 
                                   Foreground="#606066" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!-- ══ Main Dashboard Area ══════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="20,8,20,0">
                    <StackPanel>
                        <!-- System Info Card -->
                        <Border Background="#252527" CornerRadius="10" Padding="20" Margin="0,0,0,10"
                                BorderBrush="#2E2E30" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SYSTEM INFORMATION" FontSize="9" FontWeight="Black"
                                           Foreground="#505056" Margin="0,0,0,16"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Service Name" Foreground="#909094" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="ResolutePulse" Foreground="#FFFFFF" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2E2E30" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Protocol" Foreground="#909094" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Text="mTLS Secured" Foreground="#FFFFFF" FontSize="13"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Rectangle Height="1" Fill="#2E2E30" Margin="0,0,0,12"/>
                                <Grid>
                                    <TextBlock Text="Maintenance" Foreground="#909094" FontSize="13" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="BtnOpenLogs" Content="📝" ToolTip="View Agent Logs (Dev Mode)" 
                                                Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                                                Background="#2E2E30" Foreground="#A0A0A4" BorderThickness="0"
                                                FontSize="12" Cursor="Hand" Click="BtnOpenLogs_Click"
                                                Visibility="Collapsed"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                        </Button>
                                        <Button x:Name="BtnOpenConfig" Content="📁" ToolTip="Open Config Directory" 
                                                Width="28" Height="28" Padding="0"
                                                Background="#2E2E30" Foreground="#A0A0A4" BorderThickness="0"
                                                FontSize="12" Cursor="Hand" Click="BtnOpenConfig_Click"
                                                Style="{StaticResource SecondaryButtonStyle}">
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Subscription Card -->
                        <Border Background="#252527" CornerRadius="10" Padding="20"
                                BorderBrush="#2E2E30" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="SUBSCRIPTION" FontSize="9" FontWeight="Black"
                                               Foreground="#505056" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtLicenseType" Text="Checking..."
                                               Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="14"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtExpiry" Text="..." FontSize="15"
                                               Foreground="#FFFFFF" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="TxtLicenseDetail" Text="" FontSize="11"
                                               Foreground="#606066" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Error Banner -->
                        <Border x:Name="ErrorBanner" Background="#3D1A00" CornerRadius="10" Padding="16"
                                Margin="0,10,0,0" BorderBrush="#FF5B00" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="⚠  SYSTEM ISSUE" FontSize="9" FontWeight="Black"
                                           Foreground="#FF8C42" Margin="0,0,0,8"/>
                                <TextBlock x:Name="TxtError" Text="" Foreground="#FFAA66"
                                           FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ══ Main Action Button ══════════════════════════════════════ -->
            <Grid Grid.Row="3" Margin="20,14,20,20">
                <Button x:Name="BtnAction" Content="Start Agent" Height="50"
                        Style="{StaticResource ModernButtonStyle}"
                        Background="#FF5B00" Click="BtnAction_Click">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.3" Color="#FF5B00"/>
                    </Button.Effect>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
